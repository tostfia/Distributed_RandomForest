import os
import glob
import random
from typing import List
import pandas as pd
import numpy as np
from abc import ABC, abstractmethod
from sklearn.datasets import make_classification


RANDOM_SEED = 123


# ==========================================
# 1. INTERFACCIA STRATEGY
# ==========================================
class DatasetLoaderStrategy(ABC):
    @abstractmethod
    def load(self) -> pd.DataFrame:
        """Deve restituire un DataFrame standardizzato con una colonna 'Label'"""
        pass


# ==========================================
# 2. DATASET REALE
# ==========================================

class CSVDataLoader(DatasetLoaderStrategy):
    def __init__(
            self, 
            data_path: str,
            target_column: str = "Label"
    ):
        self.data_path = data_path
        self.target_column = target_column

    def load(self) -> pd.DataFrame:
        files = self._discover_csv_files()
        chunks = []

        print("Caricamento dataset reale da CSV...")

        for file_path in files:
            df_temp = self._read_single_csv(file_path)  #Lettura
            df_temp = self._standardize_columns(df_temp)    #Standardizzazione nomi colonne
            df_temp = self._standardize_target_column(df_temp, file_path)   #Standardizzazione colonna target
            df_temp = self._remove_repeated_header_rows(df_temp)    #Rimozione righe spurie
            df_temp = self._convert_feature_columns_to_numeric(df_temp)   #Conversione feature a numerico (coercing)
            chunks.append(df_temp)
        
        df = pd.concat(chunks, ignore_index=True)

        #Classificazione binaria
        df = self._encode_binary_labels(df)

        
        print("\n[OK] Dataset reale caricato correttamente.")
        print(f" • File letti:                 {len(files)}")
        print(f" • Numero totale di righe:     {df.shape[0]}")
        print(f" • Numero totale di colonne:   {df.shape[1]}")
        print(" • Target codificato:          0 = Benign, 1 = Attack")

        return df
    
    def _discover_csv_files(self) -> List[str]:#
        if os.path.isdir(self.data_path):
            files = glob.glob(os.path.join(self.data_path, "*.csv"))
        else:
            files = [self.data_path]
        
        files = sorted(files)  

        if not files:
            raise FileNotFoundError(f"Nessun file CSV trovato in '{self.data_path}'")

        for file_path in files:
            if not os.path.isfile(file_path):
                raise FileNotFoundError(f"Il file '{file_path}' non esiste.")
        return files
    

    @staticmethod
    def _read_single_csv(file_path: str) -> pd.DataFrame:
        try:
            df = pd.read_csv(file_path)   
            return df
        except Exception as e:
            raise IOError(f"Errore nella lettura del file '{file_path}': {e}")
        
    
    @staticmethod
    def _standardize_columns(df: pd.DataFrame) -> pd.DataFrame:
        df = df.copy()
        df.columns = [str(col).strip() for col in df.columns]
        return df
    

    def _standardize_target_column(self, df: pd.DataFrame, file_path: str) -> pd.DataFrame:
        df = df.copy()
        if "label" in df.columns and self.target_column not in df.columns:
            df = df.rename(columns={"label": self.target_column})
        
        if self.target_column not in df.columns:
            raise ValueError(f"Il file '{file_path}' non contiene la colonna target '{self.target_column}' né 'label'.")
        return df
    
    def _remove_repeated_header_rows(
            self,
            df: pd.DataFrame,
    ) -> pd.DataFrame:
        df = df.copy()

        label_as_str = df[self.target_column].astype(str).str.strip()

        #Rimozione righe spurie
        df = df[label_as_str != self.target_column].copy()

        return df
    
    def _convert_feature_columns_to_numeric(
        self,
        df: pd.DataFrame,
    ) -> pd.DataFrame:
        df = df.copy()

        feature_columns = df.columns.difference([self.target_column])
        df[feature_columns] = df[feature_columns].apply(
            pd.to_numeric,
            errors = "coerce",
        )
        return df
    
    def _encode_binary_labels(
            self,
            df: pd.DataFrame,
    ) -> pd.DataFrame:
        """
        Codifica la colonna Label in formato binario numerico.

        Regola:
        - 0 = Benign
        - 1 = Attack
        """

        df = df.copy()
        labels = df[self.target_column].astype(str).str.strip()

        df[self.target_column] = np.where(labels.str.lower() == "benign", 0, 1).astype(np.int8)
        return df
    

# ==========================================
# 3. DATASET SINTETICO
# ==========================================

class SyntheticDataLoader(DatasetLoaderStrategy):
    def __init__(
        self,
        n_samples: int = 100000,
        n_features: int = 20,
        random_seed: int = RANDOM_SEED,
    ):
        self.n_samples = n_samples
        self.n_features = n_features
        self.n_informative = int((n_features*0.8))
        self.random_seed = random_seed

    def load(self) -> pd.DataFrame:
        
        print(
                    f"Generazione dataset sintetico in corso "
                    f"({self.n_samples} campioni, {self.n_features} feature)..."
                )


        X, y = make_classification(
            n_samples=self.n_samples,
            n_features=self.n_features,
            n_informative=self.n_informative,
            n_redundant=2,
            n_clusters_per_class=2,
            flip_y=0.01,
            weights=[0.9, 0.1],
            random_state=self.random_seed,
        )

        feature_columns = [f"Feature_{i}" for i in range(self.n_features)]
        df = pd.DataFrame(X, columns=feature_columns)
        df["Label"] = y.astype(np.int8)

        unique, counts = np.unique(y, return_counts=True)
        print("\nDistribuzione classi nel dataset sintetico:")
        for cls, count in zip(unique, counts):
            print(f" • Classe {cls}: {count} campioni ({(count/self.n_samples)*100:.2f}%)")
        peso_mb = X.nbytes / (1024 ** 2)

        print("\n[OK] Dataset sintetico generato correttamente.")
        print(f" • Peso in RAM: {peso_mb:.2f} MB")
        print(f" • Numero di righe:     {df.shape[0]}")
        print(f" • Numero di colonne:   {df.shape[1]}")
        print(" • Target codificato:   0 = Benign, 1 = Attack")

        return df



# ==========================================
# 4. CONTEXT CLASS
# ==========================================

class DatasetLoaderContext:
    def __init__(self, strategy: DatasetLoaderStrategy):
        self.strategy = strategy

    #Permette di cambiare strategia a runtime
    def set_strategy(self, strategy: DatasetLoaderStrategy) -> None:
        self.strategy = strategy

    #Esegue il caricamento del dataset utilizzando la strategia corrente
    def execute_load(self) -> pd.DataFrame:
        return self.strategy.load()