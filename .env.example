# =============================================================================
#  Distributed Random Forest - Template di configurazione
# =============================================================================
#  Copiare questo file in '.env' e valorizzarlo per il proprio ambiente:
#
#      cp .env.example .env
#
#  Il '.env' reale NON va versionato (vedi .gitignore): contiene valori
#  specifici dell'account AWS. Questo template invece è tracciato ed è la
#  documentazione di riferimento dei parametri di deployment.
#
#  NOTA: le credenziali AWS non stanno qui. In locale vengono lette da
#  ~/.aws/credentials; per il deploy Terraform (account AWS Academy Learner
#  Lab) vanno esportate come variabili d'ambiente prima di 'terraform apply'
#  (vedi README.md, sezione "Credenziali AWS"); sulle task Fargate arrivano
#  dal ruolo IAM del task (LabRole).
# =============================================================================


# --- MODALITÀ DI ESECUZIONE --------------------------------------------------

RUNNING_IN_DOCKER=true
TRAINING_MODE=centralized
ENV_MODE=aws

SYNTHETIC_N_SAMPLES=100000
DATASET_TYPE=synthetic

# --- DIMENSIONAMENTO DEL CLUSTER ---------------------------------------------

# Numero di worker. In locale è quanti processi worker avvia il TestEngine;
# su AWS è il desired-count dei Service ECS creati da Terraform
# (num_workers in terraform.tfvars).
# NOTA: 3 come default di partenza per un primo test di funzionalità a
# basso carico, prima di risalire (es. a 7) per i test di scalabilità.
NUM_WORKERS=10
#va commentato se si vuole usare il numero di worker calcolato in base al numero di vCPU disponibili sul nodo Fargate.
WORKER_CORES=1 #più realistico rispetto ad AWS, dove ogni worker ha 1 core virtuale (1 vCPU) ma 8 thread hardware. In locale, con 8 thread hardware, un worker con 1 core può saturare la CPU e rallentare gli altri processi. Per testare la scalabilità del cluster, conviene limitare i worker a 1 core ciascuno.

# Limite di CPU per container Docker in LOCALE (letto da docker-compose.yml,
# campo 'cpus:' del servizio 'worker'). Default a 1 core: coerente con
# WORKER_CORES sopra e con AWS (dove ogni worker ha davvero 1 vCPU). Con
# molti worker e poco margine sull'host, un valore più alto (es. 8) satura
# la CPU della macchina e può bloccarla — vissuto direttamente durante lo
# sviluppo di questo progetto, da qui il default prudente.
WORKER_CPUS=1
# Limite di CPU per container Docker in LOCALE per l'orchestrator (campo
# 'cpus:' del servizio 'orchestrator'). Ruolo di coordinamento/dispatch RPC,
# non di calcolo pesante: un valore basso è sufficiente anche con più
# repliche (NUM_ORCHESTRATORS > 1).
ORCHESTRATOR_CPUS=0.5
# Limite di RAM per container Docker in LOCALE (campo 'mem_limit:' di
# entrambi i servizi in docker-compose.yml). Regolare in base alla RAM
# disponibile sull'host e a NUM_WORKERS: con molti worker, la somma di
# tutti i mem_limit non dovrebbe avvicinarsi alla RAM totale della macchina.
WORKER_MEM_LIMIT=2048m
ORCHESTRATOR_MEM_LIMIT=1024m

# Immagine usata da docker-compose per i worker locali.
IMAGE_NAME=rf-worker-local:latest

# Identificatore del nodo, incluso nel nome interno dell'orchestratore
# (es. "Orchestrator-local-centralized-<hostname>-<indice>"). Su ECS,
# Terraform imposta direttamente EC2_ID="Fargate" nella task definition
# (vedi ecs_task_definitions.tf).
EC2_ID=local

# UID/GID dell'utente Linux, usati da docker-compose per i bind mount: senza
# di questi i file scritti dai container appartengono a root e non sono
# modificabili dall'utente sull'host.
MY_UID=1000
MY_GID=1000


# --- SUPERVISOR DEI WORKER FEDERATI ------------------------------------------

# Politica di riavvio del supervisor dei worker (worker_supervisor.py).
# MAX_RESTARTS=0 disabilita il riavvio automatico: utile durante i test di
# fault tolerance, dove un worker ucciso deve restare morto abbastanza a lungo
# da far scattare la redistribuzione del chunk sui superstiti.
FED_SUPERVISOR_MAX_RESTARTS=0
FED_SUPERVISOR_BACKOFF_SECONDS=3
FED_SUPERVISOR_BACKOFF_MAX_SECONDS=60

# Quanto un worker federato attende la disponibilità del proprio shard prima
# di rinunciare.
FED_WORKER_WAIT_TIMEOUT_SECONDS=60


# --- TIMEOUT RPC -------------------------------------------------------------

# Timeout delle chiamate RPyC sincrone verso i worker, in secondi. Letti da
# env_timeout_seconds() in BaseOrchestrator.py (usato da centralized.py e
# federated.py) e direttamente da BaseWorker.py/federatedWorker.py.
# env_timeout_seconds tollera anche un eventuale suffisso "s" (es. "1800s"),
# che Terraform può propagare in ecs_task_definitions.tf: qualunque valore
# malformato produce un WARN più il default, invece di un crash all'import.
#
# Alcune chiamate RPC "leggere" (ping di latenza, lettura dimensione shard)
# usano invece un timeout breve fisso (30s), intenzionalmente diverso da
# questi: non devono competere in durata con le RPC di training vere.
RPC_SYNC_TIMEOUT_SECONDS=1800
RPC_INFERENCE_SYNC_TIMEOUT_SECONDS=900


# --- SORGENTI DATI -----------------------------------------------------------

# Cartella locale contenente i CSV del dataset reale (CICIDS).
DATASET_LOCAL_PATH=./dataset_cache

# URL S3 di default del dataset reale pubblico.
DEFAULT_DATASET_S3_URL="s3://cse-cic-ids2018/Processed Traffic Data for ML Algorithms/"


# --- RISORSE AWS (specifiche dell'account: NON committare i valori reali) -----

# Bucket S3 di lavoro: dataset condivisi, checkpoint, modelli, metriche e
# report dei test. Il nome include l'ID dell'account.
DATASETS_BUCKET_NAME=rf-distributed-datasets-378857401407-us-east-1

# Regione AWS. Letta da SystemConfig (config.py) e nativamente da boto3.
AWS_DEFAULT_REGION=us-east-1

# Endpoint di API Gateway che riceve le richieste del client in modalità AWS.
# Cambia a ogni ricreazione dello stack: da riprendere dall'output del deploy
# Terraform.
API_GATEWAY_URL=https://mnzd2sal25.execute-api.us-east-1.amazonaws.com