# === CONFIGURAZIONI E SEGRETI ===
# AGGIUNTO: '.env' non era presente in questo file, pur essendoci la sezione
# dedicata ai segreti. Contiene le credenziali AWS Academy e il progetto viene
# consegnato come link a un repository: senza questa riga rischia di finire
# nei commit. Se risulta già tracciato ('git ls-files .env'), aggiungerlo qui
# NON basta: serve anche 'git rm --cached .env'.
.env
aws_creds.sh

# Tooling e pacchetti di installazione AWS (locali)
awscliv2.zip
aws/

# Python bytecode/cache
__pycache__/
*.pyc

# Build artifacts locali
.build/

# Pipeline baseline serializzate: pesanti e rigenerabili con run_baseline().
# I manifesti config_*.json della stessa cartella restano invece TRACCIATI:
# sono la fonte di verità di iperparametri e ricetta del dataset, quindi senza
# di loro un clone del repository non riproduce gli esperimenti.
outputs_baseline/*.pkl

# === DATI LOCALI / DATABASE FINTO ===
# I JSON del DynamoDB finto vivono in data/db_files/ e in .local_storage/
# (quest'ultima già ignorata per intero più sotto): li escludiamo in modo
# MIRATO invece che con un '*.json' globale.
#
# Il pattern globale precedente escludeva da Git anche file di progetto
# essenziali — in primis src/testing/test_config.json e i manifesti
# outputs_baseline/config_*.json — che finivano comunque nell'immagine Docker
# (.dockerignore non li filtra) ma non nel repository: chi clonava il progetto
# si ritrovava senza la configurazione dei test.
data/db_files/

dataset_cache/

# Escludi i dataset CSV (sia il dataset originale che quello campionato)
data/*.csv
workers_cache/*.csv

# === PYTHON CACHE / BYTECODE ===
# File generati automaticamente da Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# === AMBIENTI VIRTUALI PYTHON ===
.venv/
venv/
env/

# === CACHE TOOLING ===
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === IDE / EDITOR ===
.vscode/
.idea/

# Ignora i database locali ma tieni la cartella
.local_storage/*
!.local_storage/.gitkeep

# Ignora i file di modello pesanti (.pkl) ma tieni la cartella
# (era '!.saved_models/.gitkeep', con un punto di troppo: l'eccezione non ha
#  mai funzionato e la cartella non veniva preservata)
saved_models/*
!saved_models/.gitkeep

# Se hai la cartella dei dati sintetici, ignora i CSV giganti
# (stesso refuso corretto: era '!.synthetic/.gitkeep')
synthetic/*
!synthetic/.gitkeep
!synthetic/*.json