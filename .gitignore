# === CONFIGURAZIONI E SEGRETI ===

# Tooling e pacchetti di installazione AWS (locali)
awscliv2.zip
aws/

*.pkl

# === DATI LOCALI / DATABASE FINTO ===
# Impedisce di caricare su Git i file JSON generati dai test locali di DynamoDB
data/db_files/
*.json

dataset_cache/

# Escludi i dataset CSV (sia il dataset originale che quello campionato)
data/*.csv
workers_cache/*.csv

# === PYTHON CACHE / BYTECODE ===
# File generati automaticamente da Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# === AMBIENTI VIRTUALI PYTHON ===
.venv/
venv/
env/

# === CACHE TOOLING ===
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === IDE / EDITOR ===
.vscode/
.idea/

# Ignora i database locali ma tieni la cartella
.local_storage/*
!.local_storage/.gitkeep

# Ignora i file di modello pesanti (.pkl) ma tieni la cartella
saved_models/*
!.saved_models/.gitkeep

# Se hai la cartella dei dati sintetici, ignora i CSV giganti
synthetic/*
!.synthetic/.gitkeep
!synthetic/*.json

